# PostgreSQL Connection from Coolify Database Resource / External DB
# Format: postgresql://<user>:<password>@<coolify-postgres-host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://postgres:***@postgres:5432/internext?schema=public"
PORT=3500
# Required for /admin and all CMS mutation/upload endpoints. Use strong unique values in deployment secrets.
ADMIN_USERNAME="change-me"
ADMIN_PASSWORD="change-me-to-a-long-random-secret"
